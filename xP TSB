    local function resetSliderVisual(sliderName, newValue)
        for _, s in ipairs(CreatedElements.Sliders) do
            if s.Text == sliderName then
                local pos = (newValue - s.Min) / (s.Max - s.Min)
                pos = math.clamp(pos, 0, 1)
                Tween(s.Fill, 0.3, {Size = UDim2.new(pos, 0, 1, 0)})
                Tween(s.Knob, 0.3, {Position = UDim2.new(pos, 0, 0.5, 0)})
                s.ValueLabel.Text = tostring(math.floor(newValue))
                break
            end
        end
    end

