    function TabObject:CreateSection(text)
        local Section = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 25), BackgroundTransparency = 1, Parent = Tab.Page
        })
        Create("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = text,
            TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left, Parent = Section
        })
        return Section
    end

    function TabObject:CreateToggle(text, default, callback, keybind) CreateToggle(Tab.Page, text, default, callback, keybind) end
    function TabObject:CreateSlider(text, min, max, default, callback) CreateSlider(Tab.Page, text, min, max, default, callback) end
    function TabObject:CreateCheckbox(text, default, callback) CreateCheckbox(Tab.Page, text, default, callback) end
    function TabObject:CreateKeybind(text, default, callback) CreateKeybind(Tab.Page, text, default, callback) end
    function TabObject:CreateButton(text, callback) CreateButton(Tab.Page, text, callback) end
    function TabObject:CreateRedButton(text, callback) CreateRedButton(Tab.Page, text, callback) end
    function TabObject:CreateColorPicker(text, defaultColor, callback, noTheme) CreateColorPicker(Tab.Page, text, defaultColor, callback, noTheme) end

    function TabObject:AddLeftGroupbox(title)
        if not Tab.TwoColumnContainer then
            Tab.TwoColumnContainer = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, Parent = Tab.Page
            })
            Tab.LeftColumn = Create("Frame", {
                Size = UDim2.new(0.5, -5, 0, 0), Position = UDim2.new(0, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Tab.TwoColumnContainer
            }, {Create("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})})
            Tab.RightColumn = Create("Frame", {
                Size = UDim2.new(0.5, -5, 0, 0), Position = UDim2.new(0.5, 5, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Tab.TwoColumnContainer
            }, {Create("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})})
        end
        return CreateGroupbox(Tab.LeftColumn, title)
    end

    function TabObject:AddRightGroupbox(title)
        if not Tab.TwoColumnContainer then
            Tab.TwoColumnContainer = Create("Frame", {
                Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, Parent = Tab.Page
            })
            Tab.LeftColumn = Create("Frame", {
                Size = UDim2.new(0.5, -5, 0, 0), Position = UDim2.new(0, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Tab.TwoColumnContainer
            }, {Create("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})})
            Tab.RightColumn = Create("Frame", {
                Size = UDim2.new(0.5, -5, 0, 0), Position = UDim2.new(0.5, 5, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Tab.TwoColumnContainer
            }, {Create("UIListLayout", {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})})
        end
        return CreateGroupbox(Tab.RightColumn, title)
    end

    return TabObject
end

-- ========================================================
-- PROCESSAMENTO GLOBAL DOS KEYBINDS DE TOGGLE
-- ========================================================
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    
    if ConsumedInputs[input] then
        ConsumedInputs[input] = nil
        return
    end
    
    for _, kb in pairs(ToggleKeybinds) do
        if kb.GetKey() and input.KeyCode == kb.GetKey() then
            local newState = not kb.State()
            kb.SetState(newState)
            
            Tween(kb.ToggleBtn, 0.2, {BackgroundColor3 = newState and Theme.ToggleOn or Theme.ToggleOff})
            Tween(kb.Circle, 0.2, {Position = newState and UDim2.new(1, -16, 0, 2) or UDim2.new(0, 2, 0, 2)})
            
            if not kb.NoNotify then
                NotifyToggle(kb.Text, newState)
            end
            
            if kb.Callback then kb.Callback(newState) end
        end
    end
end)

