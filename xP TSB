    -- ✅ CreateToggle corrigido: só reserva espaço pro keybind se existir
    local function CreateToggle(parent, text, defaultState, callback, defaultKey, noNotify)
        local ToggleFrame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.ElementBG, Parent = parent
        }, {Create("UICorner", {CornerRadius = UDim.new(0, 6)})})

        -- ✅ Se não tem keybind, label usa largura cheia (não corta texto)
        local hasKeybind = (defaultKey ~= nil)
        local labelRightPad = hasKeybind and -130 or -60

        Create("TextLabel", {
            Size = UDim2.new(1, labelRightPad, 1, 0), Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1, Text = text, TextColor3 = Theme.Text,
            Font = Enum.Font.GothamSemibold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, Parent = ToggleFrame
        })

        local ToggleBtn = Create("TextButton", {
            Size = UDim2.new(0, 36, 0, 18), Position = UDim2.new(1, -50, 0.5, -9),
            BackgroundColor3 = defaultState and Theme.ToggleOn or Theme.ToggleOff,
            Text = "", AutoButtonColor = false, Parent = ToggleFrame
        }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})

        local Circle = Create("Frame", {
            Size = UDim2.new(0, 14, 0, 14),
            Position = defaultState and UDim2.new(1, -16, 0, 2) or UDim2.new(0, 2, 0, 2),
            BackgroundColor3 = Theme.Text, Parent = ToggleBtn
        }, {Create("UICorner", {CornerRadius = UDim.new(1, 0)})})

        local state = defaultState
        table.insert(CreatedElements.Toggles, {Btn = ToggleBtn, State = state})
        local myIndex = #CreatedElements.Toggles

        -- ✅ Aceita defaultKey = false para mostrar botão vazio (sem tecla)
        if defaultKey ~= nil then
            local hasKey = (defaultKey ~= false) and defaultKey
            local displayText = hasKey and ("[" .. hasKey.Name .. "]") or "[Nenhum]"
            local displayColor = hasKey and Theme.Accent or Theme.TextDim

            local KeyBtn = Create("TextButton", {
                Size = UDim2.new(0, 72, 0, 24),
                Position = UDim2.new(1, -130, 0.5, -12),
                BackgroundColor3 = Theme.Sidebar,
                Text = displayText,
                TextColor3 = displayColor,
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                AutoButtonColor = false,
                Parent = ToggleFrame
            }, {Create("UICorner", {CornerRadius = UDim.new(0, 4)})})

            table.insert(CreatedElements.Keybinds, {Btn = KeyBtn})

            local currentKey = hasKey
            local listening = false

            KeyBtn.MouseButton1Click:Connect(function()
                listening = true
                KeyBtn.Text = "[...]"
                KeyBtn.TextColor3 = Theme.TextDim
            end)

            table.insert(ToggleKeybinds, {
                Key = currentKey,
                GetKey = function() return currentKey end,
                SetKey = function(newKey) currentKey = newKey end,
                State = function() return state end,
                SetState = function(newState) state = newState end,
                ToggleBtn = ToggleBtn,
                Circle = Circle,
                Callback = callback,
                Text = text,
                NoNotify = noNotify
            })

            local keybindIndex = #ToggleKeybinds

            UserInputService.InputBegan:Connect(function(input, gpe)
                if listening and not gpe then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        ConsumedInputs[input] = true

                        if input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Escape then
                            currentKey = nil
                            KeyBtn.Text = "[Nenhum]"
                            KeyBtn.TextColor3 = Theme.TextDim
                            listening = false
                            ToggleKeybinds[keybindIndex].Key = nil
                            return
                        end

                        currentKey = input.KeyCode
                        KeyBtn.Text = "[" .. currentKey.Name .. "]"
                        KeyBtn.TextColor3 = Theme.Accent
                        listening = false
                        ToggleKeybinds[keybindIndex].Key = currentKey
                    end
                end
            end)
        end

        ToggleBtn.MouseButton1Click:Connect(function()
            state = not state
            CreatedElements.Toggles[myIndex].State = state
            Tween(ToggleBtn, 0.2, {BackgroundColor3 = state and Theme.ToggleOn or Theme.ToggleOff})
            Tween(Circle, 0.2, {Position = state and UDim2.new(1, -16, 0, 2) or UDim2.new(0, 2, 0, 2)})
            if not noNotify then NotifyToggle(text, state) end
            if callback then callback(state) end
        end)

        AddToSearch(ToggleFrame, text)
        return ToggleFrame
    end

    local function CreateSlider(parent, text, min, max, default, callback, noNotify)
        local SliderFrame = Create("Frame", {
            Size = UDim2.new(1, 0, 0, 48), BackgroundColor3 = Theme.ElementBG, Parent = parent
        }, {Create("UICorner", {CornerRadius = UDim.new(0, 6)})})

