            Size = UDim2.new(0, 8, 0, 18), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(h, 0, 0.5, 0), BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            ZIndex = 2, Parent = HueSlider
        }, {
            Create("UICorner", {CornerRadius = UDim.new(0, 2)}),
            Create("UIStroke", {Color = Color3.fromRGB(0, 0, 0), Thickness = 1})
        })

        local RGBDisplay = Create("TextLabel", {
            Size = UDim2.new(0, 150, 0, 20), Position = UDim2.new(0, 12, 0, 196),
            BackgroundTransparency = 1, Text = "RGB: 0, 0, 0", TextColor3 = Color3.fromRGB(200, 200, 200),
            Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = Popup
        })

        local BigPreview = Create("Frame", {
            Size = UDim2.new(1, -24, 0, 30), Position = UDim2.new(0, 12, 0, 224),
            BackgroundColor3 = currentColor, BorderSizePixel = 0, Parent = Popup
        }, {
            Create("UICorner", {CornerRadius = UDim.new(0, 4)}),
            Create("UIStroke", {Color = Color3.fromRGB(60, 60, 60), Thickness = 1})
        })

        local ResetBtn = Create("TextButton", {
            Size = UDim2.new(1, -24, 0, 26), Position = UDim2.new(0, 12, 0, 266),
            BackgroundColor3 = Color3.fromRGB(50, 50, 50), Text = "Reset",
            TextColor3 = Color3.fromRGB(255, 255, 255), Font = Enum.Font.GothamBold,
            TextSize = 12, AutoButtonColor = false, Parent = Popup
        }, {Create("UICorner", {CornerRadius = UDim.new(0, 4)})})

        ResetBtn.MouseEnter:Connect(function() Tween(ResetBtn, 0.2, {BackgroundColor3 = Color3.fromRGB(70, 70, 70)}) end)
        ResetBtn.MouseLeave:Connect(function() Tween(ResetBtn, 0.2, {BackgroundColor3 = Color3.fromRGB(50, 50, 50)}) end)

        local function updatePreview()
            local newColor = Color3.fromHSV(h, s, v)
            currentColor = newColor
            ColorBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
            PreviewBtn.BackgroundColor3 = newColor
            BigPreview.BackgroundColor3 = newColor
            Crosshair.Position = UDim2.new(s, 0, 1 - v, 0)
            HueKnob.Position = UDim2.new(h, 0, 0.5, 0)
            RGBDisplay.Text = string.format("RGB: %d, %d, %d",
                math.floor(newColor.R * 255), math.floor(newColor.G * 255), math.floor(newColor.B * 255))
            if not noTheme then Library:UpdateTheme(newColor) end
            if callback then callback(newColor) end
        end

        local draggingBox = false
        local function updateFromBox(input)
            local relX = math.clamp((input.Position.X - ColorBox.AbsolutePosition.X) / ColorBox.AbsoluteSize.X, 0, 1)
            local relY = math.clamp((input.Position.Y - ColorBox.AbsolutePosition.Y) / ColorBox.AbsoluteSize.Y, 0, 1)
            s = relX; v = 1 - relY
            updatePreview()
        end
        ColorBox.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingBox = true; updateFromBox(input) end
        end)

        local draggingHue = false
        local function updateFromHue(input)
            local relX = math.clamp((input.Position.X - HueSlider.AbsolutePosition.X) / HueSlider.AbsoluteSize.X, 0, 1)
            h = relX; updatePreview()
        end
        HueSlider.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingHue = true; updateFromHue(input) end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                if draggingBox then updateFromBox(input) end
                if draggingHue then updateFromHue(input) end
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                draggingBox = false; draggingHue = false
            end
        end)

        local outsideConn = nil
        local function closePopup()
            Popup.Visible = false
            if outsideConn then outsideConn:Disconnect(); outsideConn = nil end
        end

        PreviewBtn.MouseButton1Click:Connect(function()
            if Popup.Visible then closePopup(); return end
            local btnPos = PreviewBtn.AbsolutePosition
            local popupX = btnPos.X - 200
            local popupY = btnPos.Y + 25
            local viewport = workspace.CurrentCamera.ViewportSize
            if popupX < 5 then popupX = 5 end
            if popupX + 240 > viewport.X - 5 then popupX = viewport.X - 245 end
            if popupY + 310 > viewport.Y - 5 then popupY = btnPos.Y - 320 end
            Popup.Position = UDim2.new(0, popupX, 0, popupY)
            Popup.Visible = true
            outsideConn = UserInputService.InputBegan:Connect(function(input, gpe)
                if gpe then return end
                if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
                local pos = input.Position
                local pPos = Popup.AbsolutePosition
                local pSize = Popup.AbsoluteSize
                local inPopup = pos.X >= pPos.X and pos.X <= pPos.X + pSize.X and pos.Y >= pPos.Y and pos.Y <= pPos.Y + pSize.Y
                if not inPopup then closePopup() end
            end)
        end)

        ResetBtn.MouseButton1Down:Connect(function()
            local oh, os, ov = Color3.toHSV(ORIGINAL_COLOR)
            h = oh; s = os; v = ov
            updatePreview(); closePopup()
        end)

        AddToSearch(PickerFrame, text)
        return PickerFrame
    end

