Button.TextScaled = true

-- ============================================================
-- VARIÁVEIS DE ESTADO
-- ============================================================

local character, humanoidRootPart, playerSelected
local blackHoleActive = false
local descendantConnection
local currentCharacterConnection

-- Cria o folder e a parte invisível
local Folder = Instance.new("Folder", Workspace)
local Part = Instance.new("Part", Folder)
local Attachment1 = Instance.new("Attachment", Part)
Part.Anchored = true
Part.CanCollide = false
Part.Transparency = 1

-- ============================================================
-- SISTEMA DE CONTROLE DE PARTES (Network)
-- ============================================================

if not getgenv().Network then
    getgenv().Network = {
        BaseParts = {},
        Velocity = Vector3.new(14.46262424,14.46262424,14.46262424)
    }

    Network.RetainPart = function(part)
        if part:IsA("BasePart") and part:IsDescendantOf(Workspace) then
            table.insert(Network.BaseParts, part)
            part.CustomPhysicalProperties = PhysicalProperties.new(0,0,0,0,0)
            part.CanCollide = false
        end
    end

    local function EnablePartControl()
        LocalPlayer.ReplicationFocus = Workspace
        RunService.Heartbeat:Connect(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
            for _, p in pairs(Network.BaseParts) do
                if p:IsDescendantOf(Workspace) then
                    p.Velocity = Network.Velocity
                end
            end
        end)
    end
    EnablePartControl()
end

-- ============================================================
-- FUNÇÃO PARA FORÇAR PARTES
-- ============================================================

local function ForcePart(v)
    if v:IsA("BasePart") and not v.Anchored and not v.Parent:FindFirstChildOfClass("Humanoid") and not v.Parent:FindFirstChild("Head") and v.Name ~= "Handle" then
        -- Remove BodyMovers antigos
        for _, x in ipairs(v:GetChildren()) do
            if x:IsA("BodyMover") or x:IsA("RocketPropulsion") then
                x:Destroy()
            end
        end
        if v:FindFirstChild("Attachment") then
            v:FindFirstChild("Attachment"):Destroy()
        end
        if v:FindFirstChild("AlignPosition") then
            v:FindFirstChild("AlignPosition"):Destroy()
        end
        if v:FindFirstChild("Torque") then
            v:FindFirstChild("Torque"):Destroy()
        end

        v.CanCollide = false

        local Torque = Instance.new("Torque", v)
        Torque.Torque = Vector3.new(100000,100000,100000)

        local AlignPosition = Instance.new("AlignPosition", v)
        local Attachment2 = Instance.new("Attachment", v)

        Torque.Attachment0 = Attachment2
        AlignPosition.MaxForce = math.huge
        AlignPosition.MaxVelocity = math.huge
        AlignPosition.Responsiveness = 200
        AlignPosition.Attachment0 = Attachment2
        AlignPosition.Attachment1 = Attachment1
    end
end

-- ============================================================
-- FUNÇÕES DE ATIVAÇÃO/DESATIVAÇÃO
-- ============================================================

local function toggleBlackHole()
    blackHoleActive = not blackHoleActive

    if blackHoleActive then
        Button.Text = "Bring Parts | On"

        -- Aplica em todas as partes existentes
        for _, v in ipairs(Workspace:GetDescendants()) do
            ForcePart(v)
        end

        -- Escuta novas partes adicionadas
        descendantConnection = Workspace.DescendantAdded:Connect(function(v)
            if blackHoleActive then
                ForcePart(v)
            end
        end)

        -- Loop de atualização da posição do Attachment
        spawn(function()
            while blackHoleActive and RunService.RenderStepped:Wait() do
                if humanoidRootPart then
                    Attachment1.WorldCFrame = humanoidRootPart.CFrame
                end
            end
        end)
    else
        Button.Text = "Bring Parts | Off"
        if descendantConnection then
            descendantConnection:Disconnect()
            descendantConnection = nil
        end
    end
end

-- ============================================================
-- FUNÇÃO PARA SELECIONAR ALVO
-- ============================================================

local function setTargetPlayer(player)
    if not player then
        playerSelected = nil
        character = nil
        humanoidRootPart = nil
        SelectedLabel.Text = "Selecionado: Nenhum"
        if blackHoleActive then
            toggleBlackHole()
        end
        return
    end

    playerSelected = player
    SelectedLabel.Text = "Selecionado: " .. player.Name

    if currentCharacterConnection then
        currentCharacterConnection:Disconnect()
    end

    local function updateCharacter()
        character = playerSelected.Character
        humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
    end

    updateCharacter()
    currentCharacterConnection = playerSelected.CharacterAdded:Connect(updateCharacter)
end

-- ============================================================
-- ATUALIZAR LISTA DE JOGADORES
-- ============================================================

local function refreshPlayerList()
    -- Limpa lista
    for _, child in ipairs(PlayerList:GetChildren()) do
        if child:IsA("ImageButton") then
            child:Destroy()
        end
    end

    local players = Players:GetPlayers()
    if #players == 0 then
        local empty = Instance.new("TextLabel")
        empty.Parent = PlayerList
        empty.Size = UDim2.new(1, 0, 0, 40)
        empty.BackgroundTransparency = 1
        empty.Text = "Nenhum player no servidor"
        empty.TextColor3 = Color3.new(0.7,0.7,0.7)
        empty.TextScaled = true
        updateCanvasSize()
        return
    end

    for _, plr in ipairs(players) do
        local btn = Instance.new("ImageButton")
        btn.Parent = PlayerList
        btn.Size = UDim2.new(1, 0, 0, 48)
        btn.BackgroundColor3 = Color3.fromRGB(65,65,65)
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = true

        -- Avatar thumbnail
        local avatar = Instance.new("ImageLabel")
        avatar.Parent = btn
        avatar.Size = UDim2.new(0, 38, 0, 38)
        avatar.Position = UDim2.new(0, 5, 0.5, -19)
        avatar.BackgroundTransparency = 1
        avatar.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. plr.UserId .. "&width=48&height=48"

        -- Nome
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Parent = btn
        nameLabel.Size = UDim2.new(1, -50, 1, 0)
        nameLabel.Position = UDim2.new(0, 48, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = plr.Name
        nameLabel.TextColor3 = Color3.new(1,1,1)
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.TextScaled = true
        nameLabel.Font = Enum.Font.GothamBold

        btn.MouseButton1Click:Connect(function()
            setTargetPlayer(plr)
        end)
    end

    updateCanvasSize()
end

-- ============================================================
-- EVENTOS DA LISTA
-- ============================================================

Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)
refreshPlayerList()

-- ============================================================
-- EVENTO DO BOTÃO DE ATIVAÇÃO
-- ============================================================

Button.MouseButton1Click:Connect(function()
    if not playerSelected then
        SelectedLabel.Text = "Selecione um player!"
        task.wait(1)
        SelectedLabel.Text = playerSelected and ("Selecionado: " .. playerSelected.Name) or "Selecionado: Nenhum"
        return
    end
    toggleBlackHole()
end)

