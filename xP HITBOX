-- ============================================================
-- DRAG DA JANELA
-- ============================================================

local dragging = false
local dragStartPos, dragStartMousePos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStartPos = mainFrame.Position
        dragStartMousePos = input.Position
    end
end)

titleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStartMousePos
        mainFrame.Position = UDim2.new(
            dragStartPos.X.Scale, dragStartPos.X.Offset + delta.X,
            dragStartPos.Y.Scale, dragStartPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- ============================================================
-- FUNÇÕES PRINCIPAIS
-- ============================================================

local function restoreAllHeads()
    for head, data in pairs(originalHeadData) do
        if head and head.Parent then
            head.Size = data.Size
            head.Transparency = data.Transparency
        end
    end
    originalHeadData = {}
end

local function updateAllHeads()
    if not HitboxEnabled then return end

    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer == player then continue end
        local char = otherPlayer.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not (hum and hum.Health > 0) then continue end
        local head = char:FindFirstChild("Head")
        if not head then continue end

        -- Salva dados originais se não salvos ainda
        if not originalHeadData[head] then
            originalHeadData[head] = {
                Size = head.Size,
                Transparency = head.Transparency
            }
        end

        -- Aplica novo tamanho
        local newSize = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
        if head.Size ~= newSize then
            head.Size = newSize
        end

        -- Aplica transparência se ativada
        local newTrans = TransparencyEnabled and 0.5 or originalHeadData[head].Transparency
        if head.Transparency ~= newTrans then
            head.Transparency = newTrans
        end
    end
end

-- ============================================================
-- EVENTOS DOS BOTÕES
-- ============================================================

-- Hitbox ON/OFF
hitboxToggleBtn.MouseButton1Click:Connect(function()
    HitboxEnabled = not HitboxEnabled
    hitboxToggleBtn.Text = HitboxEnabled and "Hitbox: ON" or "Hitbox: OFF"

    if not HitboxEnabled then
        restoreAllHeads()
    else
        updateAllHeads()
    end
end)

-- Slider de tamanho
local sliderActive = false

sliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderActive = true
    end
end)

sliderBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderActive = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderActive and input.UserInputType == Enum.UserInputType.MouseMovement then
        local relativeX = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        HitboxSize = 1 + relativeX * 5
        HitboxSize = math.round(HitboxSize * 10) / 10

        sliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
        sliderBtn.Position = UDim2.new(relativeX, -7, 0, -5)
        sizeLabel.Text = string.format("Tamanho: %.1f", HitboxSize)

        if HitboxEnabled then
            updateAllHeads()
        end
    end
end)

-- Transparência
transToggleBtn.MouseButton1Click:Connect(function()
    TransparencyEnabled = not TransparencyEnabled
    transToggleBtn.Text = TransparencyEnabled and "Transparência: ON" or "Transparência: OFF"
    if HitboxEnabled then
        updateAllHeads()
    end
end)

-- Fechar janela
closeBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = false
end)

-- Alternar com Alt (esquerdo ou direito)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
        mainFrame.Visible = not mainFrame.Visible
    end
end)

-- Loop de atualização (a cada 0.5s)
task.spawn(function()
    while true do
        task.wait(0.5)
        if HitboxEnabled then
            updateAllHeads()
        end
    end
end)

-- Notificação
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "xP Hitbox",
    Text = "Carregado! Pressione Alt para mostrar/ocultar.",
    Duration = 4
})
