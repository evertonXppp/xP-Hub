local function GetRealBall()
    local balls = Workspace:FindFirstChild("Balls")
    if not balls then return nil end
    for _, ball in ipairs(balls:GetChildren()) do
        if ball:IsA("BasePart") and ball:GetAttribute("realBall") == true then return ball end
    end
    return nil
end

local function IsTargeted(ball)
    if not ball then return false end
    return ball:GetAttribute("target") == Player.Name
end

local function GetBallColor(target)
    if not target then return Color3.new(1, 1, 1) end
    local highlight = target:FindFirstChildOfClass("Highlight")
    if highlight then return highlight.FillColor end
    return (target:IsA("BasePart") and target.Color) or Color3.new(1, 1, 1)
end

local function GetVisualHeight(shadow)
    if not shadow then return 0 end
    local ok, h = pcall(function()
        return math.min(((math.max(0, shadow.Size.X - 5)) * 20) + 3, 100)
    end)
    return ok and h or 0
end

local function GetDistanceToBall(ball)
    local char = Player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not ball then return math.huge end
    return (hrp.Position - ball.Position).Magnitude
end

local function GetBallSpeed(ball)
    if not ball then return 0 end
    if ball:FindFirstChild("zoomies") then
        return ball.zoomies.VectorVelocity.Magnitude
    end
    return ball.Velocity.Magnitude
end

-- ============================================================
-- AÇÕES (delays FIXOS - sem humanize)
-- ============================================================
local function SendParry()
    local now = tick()
    if now - LastParry < 0.1 then return end
    LastParry = now

    local useRemote = math.random() > 0.4
    if useRemote then
        local sent = pcall(function()
            local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if Remotes then
                local ParryRemote = Remotes:FindFirstChild("ParryButtonPress")
                    or Remotes:FindFirstChild("Parry")
                    or Remotes:FindFirstChild("ParryEvent")
                if ParryRemote then ParryRemote:FireServer(); return true end
            end
            return false
        end)
        if sent then return end
    end

    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.012)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

local function SendAbility()
    local now = tick()
    if now - LastAbility < 1.2 then return end
    LastAbility = now
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
        task.wait(0.01)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
    end)
end

local function AutoWinLogic()
    if not AutoWinActive then return end
    local balls = Workspace:FindFirstChild("Balls")
    if not balls then return end
    for _, ball in ipairs(balls:GetChildren()) do
        if ball and ball:IsA("BasePart") and ball:GetAttribute("realBall") then
            if IsTargeted(ball) then SendParry() end
        end
    end
end

local function GetNearestPlayer()
    local nearest = nil
    local minDist = math.huge
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - hrp.Position).Magnitude
                if dist < minDist then minDist = dist; nearest = plr end
            end
        end
    end
    return nearest
end

local function AutoDetectSpamLogic(ball)
    if not AutoDetectSpamActive or not ball then SpamActive = false; return end
    local nearest = GetNearestPlayer()
    if not nearest then SpamActive = false; return end
    local nearestChar = nearest.Character
    if not nearestChar or not nearestChar:FindFirstChild("HumanoidRootPart") then SpamActive = false; return end
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then SpamActive = false; return end
    local playerDist = (hrp.Position - nearestChar.HumanoidRootPart.Position).Magnitude
    local ballDist = GetDistanceToBall(ball)
    local detectDistance = 25 + math.clamp(ParryCounter / 3, 0, 25)
    SpamActive = (ParryCounter > 2 and playerDist < detectDistance and ballDist < 55)
end

local function AutoSpamLogic()
    if not Settings.AutoSpam or not SpamActive then return end
    for i = 1, math.floor(Settings.SpamSpeed) do
        SendParry()
        task.wait(0.03)
    end
end

-- ============================================================
-- LOOP PRINCIPAL
-- ============================================================
RunService.RenderStepped:Connect(function(dt)
    if AutoWinActive then AutoWinLogic(); return end
    if not (Settings.AutoParry or Settings.PanicAbility) then return end

    local char = Player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then PreviousPosition = nil; return end

    local charPos = hrp.Position

    local ball = GetRealBall()
    BallShadow = (BallShadow and BallShadow.Parent) and BallShadow
        or (Workspace:FindFirstChild("FX") and Workspace.FX:FindFirstChild("BallShadow"))
    BallObject = ball or (BallObject and BallObject.Parent and BallObject) or Workspace:FindFirstChild("Ball")

    if not ball and not BallShadow then PreviousPosition = nil; return end

    local currentPos
    if ball then
        currentPos = ball.Position
    elseif BallShadow then
        local height = GetVisualHeight(BallShadow)
        currentPos = Vector3.new(
            BallShadow.Position.X,
            BallShadow.Position.Y + height,
            BallShadow.Position.Z
        )
    else
        PreviousPosition = nil; return
    end

    local ballColor = GetBallColor(ball or BallObject)
    local isRealBall = ballColor ~= Color3.new(1, 1, 1)

    if PreviousPosition and isRealBall then
        local velocityVector = (currentPos - PreviousPosition) / dt
        local velocityMagnitude = velocityVector.Magnitude

        local shouldParry = false
        local distance = (charPos - currentPos).Magnitude

        local dirToPlayer = (charPos - currentPos).Unit
        local velDir = velocityVector.Unit
        local accuracy = Settings.UseAccuracy and velDir:Dot(dirToPlayer) or 1

        local curveDelay = math.clamp((1 - accuracy) * 0.1, 0, 0.15)

        if velocityMagnitude < Settings.SpeedThreshold then
            local leadTime = math.clamp(0.05 + (velocityMagnitude / 600), 0.05, 0.2)
            local predictedPos = currentPos + velocityVector * leadTime
            local flatDistance = (Vector3.new(charPos.X, 0, charPos.Z) - Vector3.new(predictedPos.X, 0, predictedPos.Z)).Magnitude
            local dynamicDistance = math.clamp(12 + velocityMagnitude * 0.05, 8, 55)

            if flatDistance <= (dynamicDistance - (curveDelay * 10)) then
                shouldParry = true
            end
        else
            if accuracy > 0.15 then
                local timeToImpact = distance / velocityMagnitude
                local reactionWindow = 0.1 + (dt * 1.5) - curveDelay
                reactionWindow = math.max(reactionWindow, Settings.ReactionTime * 0.5)

                if timeToImpact <= reactionWindow then
                    shouldParry = true
                end
            end
        end

        if shouldParry then
            local safeDelay = math.clamp(0.02 + (velocityMagnitude / 250), 0.01, 0.1)
            if (tick() - LastParry) > safeDelay then
                SendParry()
                LastParry = tick()
            end
        end
    end

    if Settings.PanicAbility and ball then
        local dist = GetDistanceToBall(ball)
        if dist <= Settings.PanicDistance then
            SendAbility()
        end
    end

    if ball then
        AutoDetectSpamLogic(ball)
        AutoSpamLogic()
    end

    PreviousPosition = currentPos
end)

pcall(function()
    Workspace:WaitForChild("Balls").ChildAdded:Connect(function()
        task.wait(0.15)
        Parried = false
    end)
end)

