    function TabObject:CreateSearchBar(placeholder)
        placeholder = placeholder or "Pesquisar"
        local SF = Create("Frame", {Size = UDim2.new(1,0,0,38), BackgroundColor3 = Theme.SearchBG, BorderSizePixel = 0, Parent = Tab.Page}, {Create("UICorner", {CornerRadius = UDim.new(0,8)}), Create("UIStroke", {Color = Color3.fromRGB(45,45,45), Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})})
        Create("TextLabel", {Size = UDim2.new(0,26,0,26), Position = UDim2.new(0,8,0.5,-13), BackgroundTransparency = 1, Text = "🔍", TextColor3 = Color3.fromRGB(150,150,150), Font = Enum.Font.Gotham, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, Parent = SF})
        local SB = Create("TextBox", {Size = UDim2.new(1,-45,1,0), Position = UDim2.new(0,38,0,0), BackgroundTransparency = 1, Text = "", PlaceholderText = placeholder, PlaceholderColor3 = Color3.fromRGB(120,120,120), TextColor3 = Color3.fromRGB(255,255,255), Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, ClearTextOnFocus = false, Parent = SF})
        SB:GetPropertyChangedSignal("Text"):Connect(function()
            local q = string.lower(SB.Text)
            for _, e in pairs(Tab.Elements) do
                if e.Frame and e.Frame.Parent then
                    local st = string.lower(e.SearchText or "")
                    e.Frame.Visible = (q == "" or string.find(st, q, 1, true)) and true or false
                end
            end
        end)
        SB.Focused:Connect(function() Tween(SF, 0.2, {BackgroundColor3 = Color3.fromRGB(38,38,38)}) end)
        SB.FocusLost:Connect(function() Tween(SF, 0.2, {BackgroundColor3 = Theme.SearchBG}) end)
        return SF
    end

    function TabObject:CreateToggle(t,d,c,k) CreateToggle(Tab.Page,t,d,c,k) end
    function TabObject:CreateSlider(t,mn,mx,d,c) CreateSlider(Tab.Page,t,mn,mx,d,c) end
    function TabObject:CreateCheckbox(t,d,c) CreateCheckbox(Tab.Page,t,d,c) end
    function TabObject:CreateKeybind(t,d,c) CreateKeybind(Tab.Page,t,d,c) end
    function TabObject:CreateButton(t,c) CreateButton(Tab.Page,t,c) end
    function TabObject:CreateRedButton(t,c) CreateRedButton(Tab.Page,t,c) end
    function TabObject:CreateColorPicker(t,d,c,nt) CreateColorPicker(Tab.Page,t,d,c,nt) end

    function TabObject:AddLeftGroupbox(title)
        if not Tab.TwoColumnContainer then
            Tab.TwoColumnContainer = Create("Frame", {Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Tab.Page})
            Tab.LeftColumn = Create("Frame", {Size = UDim2.new(0.5,-5,0,0), Position = UDim2.new(0,0,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Tab.TwoColumnContainer}, {Create("UIListLayout", {Padding = UDim.new(0,10), SortOrder = Enum.SortOrder.LayoutOrder})})
            Tab.RightColumn = Create("Frame", {Size = UDim2.new(0.5,-5,0,0), Position = UDim2.new(0.5,5,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Tab.TwoColumnContainer}, {Create("UIListLayout", {Padding = UDim.new(0,10), SortOrder = Enum.SortOrder.LayoutOrder})})
        end
        return CreateGroupbox(Tab.LeftColumn, title)
    end

    function TabObject:AddRightGroupbox(title)
        if not Tab.TwoColumnContainer then
            Tab.TwoColumnContainer = Create("Frame", {Size = UDim2.new(1,0,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Tab.Page})
            Tab.LeftColumn = Create("Frame", {Size = UDim2.new(0.5,-5,0,0), Position = UDim2.new(0,0,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Tab.TwoColumnContainer}, {Create("UIListLayout", {Padding = UDim.new(0,10), SortOrder = Enum.SortOrder.LayoutOrder})})
            Tab.RightColumn = Create("Frame", {Size = UDim2.new(0.5,-5,0,0), Position = UDim2.new(0.5,5,0,0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = Tab.TwoColumnContainer}, {Create("UIListLayout", {Padding = UDim.new(0,10), SortOrder = Enum.SortOrder.LayoutOrder})})
        end
        return CreateGroupbox(Tab.RightColumn, title)
    end

    function TabObject:CreateGroupbox(title)
        return CreateGroupbox(Tab.Page, title)
    end

    function TabObject:CreateLogContainer()
        local LC = Create("ScrollingFrame", {Size = UDim2.new(1,0,1,-40), BackgroundColor3 = Theme.ElementBG, BorderSizePixel = 0, ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Accent, CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, ElasticBehavior = Enum.ElasticBehavior.Never, Parent = Tab.Page}, {Create("UICorner", {CornerRadius = UDim.new(0,6)}), Create("UIListLayout", {Padding = UDim.new(0,6), SortOrder = Enum.SortOrder.LayoutOrder}), Create("UIPadding", {PaddingTop = UDim.new(0,10), PaddingLeft = UDim.new(0,12), PaddingRight = UDim.new(0,12), PaddingBottom = UDim.new(0,10)})})
        function TabObject:AddLog(message)
            local color = Theme.Text
            local p = string.sub(message, 1, 3)
            if p == "[+]" then color = Theme.LogAdd
            elseif p == "[-]" then color = Theme.LogRemove
            elseif p == "[=]" then color = Theme.LogFix end
            local L = Create("TextLabel", {Size = UDim2.new(1,0,0,18), BackgroundTransparency = 1, Text = message, TextColor3 = color, Font = Enum.Font.Code, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = LC})
            L.TextTransparency = 1; Tween(L, 0.3, {TextTransparency = 0})
            return L
        end
        return LC
    end

    function TabObject:CreateWelcomeBanner()
        local B = Create("Frame", {Size = UDim2.new(1,0,0,90), BackgroundColor3 = Theme.TabsBG, BorderSizePixel = 0, Parent = Tab.Page}, {Create("UICorner", {CornerRadius = UDim.new(0,8)}), Create("UIStroke", {Color = Theme.Accent, Thickness = 1, Transparency = 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border})})
        Create("TextLabel", {Size = UDim2.new(1,-20,0,30), Position = UDim2.new(0,15,0,15), BackgroundTransparency = 1, Text = "Bem-vindo, " .. Player.DisplayName .. "!", TextColor3 = Theme.Text, Font = Enum.Font.GothamBold, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Parent = B})
        Create("TextLabel", {Size = UDim2.new(1,-20,0,30), Position = UDim2.new(0,15,0,45), BackgroundTransparency = 1, Text = "Aproveite o xP Hub. Use o menu lateral para navegar.", TextColor3 = Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = B})
        return B
    end

    function TabObject:CreateInfoCard(title, value)
        local C = Create("Frame", {Size = UDim2.new(1,0,0,40), BackgroundColor3 = Theme.ElementBG, Parent = Tab.Page}, {Create("UICorner", {CornerRadius = UDim.new(0,6)})})
        Create("TextLabel", {Size = UDim2.new(0.5,-15,1,0), Position = UDim2.new(0,15,0,0), BackgroundTransparency = 1, Text = title, TextColor3 = Theme.TextDim, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, Parent = C})
        Create("TextLabel", {Size = UDim2.new(0.5,-15,1,0), Position = UDim2.new(0.5,0,0,0), BackgroundTransparency = 1, Text = value, TextColor3 = Theme.Accent, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Center, Parent = C})
        return C
    end

    return TabObject
end

-- Keybind global
UserInputService.InputBegan:Connect(function(input, gpe)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if ConsumedInputs[input] then ConsumedInputs[input] = nil; return end
    for _, kb in pairs(ToggleKeybinds) do
        if kb.GetKey() and input.KeyCode == kb.GetKey() then
            local ns = not kb.State()
            kb.SetState(ns)
            Tween(kb.ToggleBtn, 0.2, {BackgroundColor3 = ns and Theme.ToggleOn or Theme.ToggleOff})
            Tween(kb.Circle, 0.2, {Position = ns and UDim2.new(1,-16,0,2) or UDim2.new(0,2,0,2)})
            if not kb.NoNotify then NotifyToggle(kb.Text, ns) end
            if kb.Callback then kb.Callback(ns) end
        end
    end
end)

