local function SetParticlesEnabled(enabled)
    if enabled then
        for inst, state in pairs(savedParticleStates) do
            if inst and inst.Parent then pcall(function() inst.Enabled = state end) end
        end
        savedParticleStates = {}
    else
        for _, obj in ipairs(Workspace:GetDescendants()) do
            local t = obj.ClassName
            if t == "ParticleEmitter" or t == "Trail" or t == "Beam" or t == "Smoke" or t == "Fire" then
                if savedParticleStates[obj] == nil then
                    pcall(function() savedParticleStates[obj] = obj.Enabled end)
                end
                pcall(function() obj.Enabled = false end)
            end
        end
    end
end

local function SetFogDisabled(disabled)
    pcall(function()
        if not disabled then
            if savedLighting.FogStart ~= nil then
                Lighting.FogStart = savedLighting.FogStart
                Lighting.FogEnd = savedLighting.FogEnd
                Lighting.FogColor = savedLighting.FogColor
            end
            savedLighting.FogStart = nil
        else
            if savedLighting.FogStart == nil then
                savedLighting.FogStart = Lighting.FogStart
                savedLighting.FogEnd = Lighting.FogEnd
                savedLighting.FogColor = Lighting.FogColor
            end
            Lighting.FogStart = 0
            Lighting.FogEnd = 9e9
        end
    end)
end

local function SetLowGraphics(on)
    pcall(function()
        if on then
            if savedLighting.GlobalShadows == nil then
                savedLighting.GlobalShadows = Lighting.GlobalShadows
                savedLighting.Ambient = Lighting.Ambient
                savedLighting.Brightness = Lighting.Brightness
            end
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(180, 180, 180)
            Lighting.Brightness = math.max(0, (Lighting.Brightness or 1) * 0.7)
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        else
            if savedLighting.GlobalShadows ~= nil then
                Lighting.GlobalShadows = savedLighting.GlobalShadows
                Lighting.Ambient = savedLighting.Ambient
                Lighting.Brightness = savedLighting.Brightness
                savedLighting.GlobalShadows = nil
            end
        end
    end)
end

local function SetOptimizedMode(on)
    OptimizedMode = on
    if on then SetFogDisabled(true); SetParticlesEnabled(false); SetLowGraphics(true)
    else SetFogDisabled(false); SetParticlesEnabled(true); SetLowGraphics(false) end
end

