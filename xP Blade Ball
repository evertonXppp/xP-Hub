        local function GetRealBall()
            local balls = Workspace:FindFirstChild("Balls")
            if not balls then return nil end
            for _, ball in ipairs(balls:GetChildren()) do
                if ball:IsA("BasePart") and ball:GetAttribute("realBall") == true then
                    return ball
                end
            end
            return nil
        end
        local function IsTargeted(ball)
            if not ball then return false end
            return ball:GetAttribute("target") == Player.Name
        end
        local function GetDistanceToBall(ball)
            local char = Player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp or not ball then return math.huge end
            return (hrp.Position - ball.Position).Magnitude
        end
        local function GetBallSpeed(ball)
            if not ball then return 0 end
            if ball:FindFirstChild("zoomies") then
                return ball.zoomies.VectorVelocity.Magnitude
            end
            return ball.Velocity.Magnitude
        end
        local function SendParry()
            if tick() - LastParry < 0.1 then return end
            LastParry = tick()
            pcall(function()
                local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if Remotes then
                    local ParryRemote = Remotes:FindFirstChild("ParryButtonPress") or Remotes:FindFirstChild("Parry")
                    if ParryRemote then
                        ParryRemote:FireServer()
                        return
                    end
                end
            end)
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.012)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end
        local function SendAbility()
            if tick() - LastAbility < 1.2 then return end
            LastAbility = tick()
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                task.wait(0.01)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
            end)
        end
        local function AutoWinLogic()
            if not AutoWinActive then return end
            for _, ball in ipairs(Workspace.Balls:GetChildren()) do
                if ball and ball:IsA("BasePart") and ball:GetAttribute("realBall") then
                    local char = Player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = CFrame.new(hrp.Position, ball.Position)
                        if IsTargeted(ball) then
                            SendParry()
                        end
                    end
                end
            end
        end
        local function GetNearestPlayer()
            local nearest = nil
            local minDist = math.huge
            local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return nil end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= Player then
                    local char = plr.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local dist = (char.HumanoidRootPart.Position - hrp.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            nearest = plr
                        end
                    end
                end
            end
            return nearest
        end
        local function AutoDetectSpamLogic(ball)
            if not AutoDetectSpamActive or not ball then
                SpamActive = false
                return
            end
            local nearest = GetNearestPlayer()
            if not nearest then
                SpamActive = false
                return
            end
            local nearestChar = nearest.Character
            if not nearestChar or not nearestChar:FindFirstChild("HumanoidRootPart") then
                SpamActive = false
                return
            end
            local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then
                SpamActive = false
                return
            end
            local playerDist = (hrp.Position - nearestChar.HumanoidRootPart.Position).Magnitude
            local ballDist = GetDistanceToBall(ball)
            local detectDistance = 25 + math.clamp(ParryCounter / 3, 0, 25)
            SpamActive = (ParryCounter > 2 and playerDist < detectDistance and ballDist < 55)
        end
        local function AutoSpamLogic()
            if not Settings.AutoSpam or not SpamActive then return end
            for i = 1, math.floor(Settings.SpamSpeed) do
                SendParry()
                task.wait(0.03)
            end
        end
        RunService.PreSimulation:Connect(function()
            if AutoWinActive then
                AutoWinLogic()
                return
            end
            if Settings.AutoParry or Settings.PanicAbility then
                local ball = GetRealBall()
                if not ball then return end
                local char = Player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local distance = GetDistanceToBall(ball)
                local velocity = GetBallSpeed(ball)
                if velocity < 3 then return end
                local timeToImpact = (distance - 2.5) / velocity
                pcall(function()
                    ball:GetAttributeChangedSignal("target"):Connect(function()
                        local target = ball:GetAttribute("target")
                        local nearest = GetNearestPlayer()
                        if nearest then
                            if target == nearest.Name or target == Player.Name then
                                ParryCounter = ParryCounter + 1
                            else
                                ParryCounter = 0
                            end
                        end
                    end)
                end)
                AutoDetectSpamLogic(ball)
                AutoSpamLogic()
                if Settings.AutoParry and IsTargeted(ball) and timeToImpact <= Settings.ReactionTime then
                    if not Parried then
                        SendParry()
                        Parried = true
                        task.delay(0.5, function() Parried = false end)
                    end
                end
                if Settings.PanicAbility and distance <= Settings.PanicDistance then
                    SendAbility()
                end
            end
        end)
