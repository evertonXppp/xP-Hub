local Invisible = { remote = nil, hooked = false, originalCF = nil }

local function hookReplicationRemote(remote)
    if Invisible.hooked then return end
    Invisible.hooked = true
    Invisible.remote = remote
    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    mt.__namecall = newcclosure(function(self, ...)
        if getnamecallmethod() == "FireServer" and self == Invisible.remote and getgenv().InvisibleBlock then
            return nil
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
end

local function setInvisible(enable)
    Features.Invisible.enabled = enable
    if enable then
        local char = LP.Character
        if not char then notify("Invisible", "Sem personagem!"); Features.Invisible.enabled = false; return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
