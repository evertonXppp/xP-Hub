-- HITBOX EXPANDER
local HitboxState = { x = 0, y = 0, z = 0, active = false, installed = false, showCircle = false }
local DEFAULT_HITBOX = Vector3.new(5, 4, 5)
local HitboxHooked = false
local OriginalBox = nil
local CachedCore = nil
local OurHookFn = nil
local CircleBox = { part = nil }

local function getOrCreateCirclePart()
    if CircleBox.part and CircleBox.part.Parent then return CircleBox.part end
    local existing = workspace:FindFirstChild("HitboxVisualizer_xPHub")
    if existing then existing:Destroy() end
    local part = Instance.new("Part")
    part.Name = "HitboxVisualizer_xPHub"
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Transparency = 0.75
    part.Material = Enum.Material.ForceField
    part.Color = Color3.fromRGB(0, 255, 100)
    part.CastShadow = false
    part.Parent = workspace
    CircleBox.part = part
    return part
end

local function destroyCirclePart()
    if CircleBox.part then
        pcall(function() CircleBox.part:Destroy() end)
        CircleBox.part = nil
    end
end

local function updateCircleVisual()
    if not HitboxState.showCircle then destroyCirclePart(); return end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then destroyCirclePart(); return end
    local part = getOrCreateCirclePart()
    local sx, sy, sz
    if not HitboxState.active then
        sx, sy, sz = DEFAULT_HITBOX.X, DEFAULT_HITBOX.Y, DEFAULT_HITBOX.Z
    else
        sx = math.max(tonumber(HitboxState.x) or 0, 0)
        sy = math.max(tonumber(HitboxState.y) or 0, 0)
        sz = math.max(tonumber(HitboxState.z) or 0, 0)
    end
    local isActiveSize = (sx > 0 or sy > 0 or sz > 0)
    local visX = sx > 0 and sx or 3
    local visY = sy > 0 and sy or 3
    local visZ = sz > 0 and sz or 3
    part.Size = Vector3.new(visX, visY, visZ)
    part.CFrame = hrp.CFrame
    if isActiveSize and HitboxState.active then
        part.Color = Color3.fromRGB(0, 255, 100)
    elseif not HitboxState.active then
        part.Color = Color3.fromRGB(150, 150, 255)
    else
        part.Color = Color3.fromRGB(255, 60, 60)
    end
end

task.spawn(function()
    while getgenv()._xPHub_ALIVE do
        if HitboxState.showCircle then updateCircleVisual() end
        task.wait(0.05)
    end
end)

local function getCore()
    if CachedCore then return CachedCore end
    local ok, core = pcall(function() return require(ReplicatedStorage:WaitForChild("Core")) end)
    if ok and core then CachedCore = core; return core end
    return nil
end

local function makeHook()
    if OurHookFn then return OurHookFn end
    OurHookFn = newcclosure(function(...)
        local args = { ... }
        local char = args[2]
        local config = args[3]
        if char == nil then return OriginalBox(unpack(args)) end
        local sx, sy, sz
        if not HitboxState.active then
            sx, sy, sz = DEFAULT_HITBOX.X, DEFAULT_HITBOX.Y, DEFAULT_HITBOX.Z
        else
            sx = tonumber(HitboxState.x) or 0
            sy = tonumber(HitboxState.y) or 0
            sz = tonumber(HitboxState.z) or 0
            if sx == 0 and sy == 0 and sz == 0 then return OriginalBox(unpack(args)) end
        end
        config = config or {}
        local cur = config.Size or Vector3.new(1, 1, 1)
        config.Size = Vector3.new(sx > 0 and sx or cur.X, sy > 0 and sy or cur.Y, sz > 0 and sz or cur.Z)
        args[3] = config
        return OriginalBox(unpack(args))
    end)
    return OurHookFn
end

local function ensureHook()
    local Core = getCore()
    if not Core then return false end
    local combatHit = Core.Get and Core.Get("Combat", "Hit")
    if not combatHit or not combatHit.Box then return false end
    if combatHit.Box == OurHookFn then
        HitboxHooked = true
        HitboxState.installed = true
        return true
    end
    if not OriginalBox then OriginalBox = combatHit.Box end
    pcall(function() combatHit.Box = makeHook() end)
    HitboxHooked = (combatHit.Box == OurHookFn)
    if HitboxHooked then HitboxState.installed = true end
    return HitboxHooked
end

task.spawn(function()
    while getgenv()._xPHub_ALIVE do
        if HitboxState.installed then ensureHook() end
        task.wait(0.5)
    end
end)

-- KILL AURA RANGE RING
local KillAuraRing = { folder = nil, segments = {}, conn = nil, SEGMENTS = 72 }

local function destroyKillAuraRing()
    if KillAuraRing.folder then pcall(function() KillAuraRing.folder:Destroy() end) end
    KillAuraRing.folder = nil
    KillAuraRing.segments = {}
end

local function createKillAuraRing()
    local existing = workspace:FindFirstChild("KillAuraRing_xPHub")
    if existing then existing:Destroy() end
    local folder = Instance.new("Folder")
    folder.Name = "KillAuraRing_xPHub"
    folder.Parent = workspace
    KillAuraRing.folder = folder
    KillAuraRing.segments = {}
    for i = 1, KillAuraRing.SEGMENTS do
        local seg = Instance.new("Part")
        seg.Name = "Segment_" .. i
        seg.Shape = Enum.PartType.Block
        seg.Anchored = true
        seg.CanCollide = false
        seg.CanQuery = false
        seg.CanTouch = false
        seg.CastShadow = false
        seg.Material = Enum.Material.Neon
        seg.TopSurface = Enum.SurfaceType.Smooth
        seg.BottomSurface = Enum.SurfaceType.Smooth
        seg.Color = Color3.fromRGB(30, 80, 190)
        seg.Transparency = 0.55
        seg.Parent = folder
        KillAuraRing.segments[i] = seg
    end
end

local function updateKillAuraRing()
    if not Features.KillAura.showRange then
        if KillAuraRing.folder then destroyKillAuraRing() end
        return
    end
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        if KillAuraRing.folder then destroyKillAuraRing() end
        return
    end
    if not KillAuraRing.folder or not KillAuraRing.folder.Parent then createKillAuraRing() end
    local radius = math.max(tonumber(Features.KillAura.config.MaxDistance) or 100, 5)
    local arcAngle = (2 * math.pi) / KillAuraRing.SEGMENTS
    local chordLength = 2 * radius * math.sin(arcAngle / 2)
    local segLength = chordLength * 1.35
    local thickness = math.max(radius * 0.02, 0.3)
    local height = 0.1
    local basePos = hrp.Position + Vector3.new(0, 1, 0)
    local isOn = Features.KillAura.enabled
    local color = isOn and Color3.fromRGB(10, 50, 180) or Color3.fromRGB(30, 80, 190)
    local transparency = isOn and 0.35 or 0.55
    for i = 1, KillAuraRing.SEGMENTS do
        local seg = KillAuraRing.segments[i]
        if seg and seg.Parent then
            local a = (i - 1) * arcAngle
            local x = math.cos(a) * radius
            local z = math.sin(a) * radius
            seg.Size = Vector3.new(segLength, height, thickness)
            seg.CFrame = CFrame.new(basePos + Vector3.new(x, 0, z)) * CFrame.Angles(0, -(a + math.pi / 2), 0)
            seg.Color = color
            seg.Transparency = transparency
        end
    end
end

KillAuraRing.conn = RunService.RenderStepped:Connect(updateKillAuraRing)

