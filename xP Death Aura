-- ============================================================
-- UNLOAD COMPLETO
-- ============================================================
local function unloadAll()
    -- 1) Mata todos os loops/threads
    getgenv()._xPHub_ALIVE = false

    -- 2) Desliga todas as features e restaura settings
    pcall(function()
        for _, v in pairs(Features) do
            if type(v) == "table" and v.enabled ~= nil then
                v.enabled = false
            end
        end
        Features.KillAura.showRange = false
        Features.XRay.enabled = false
        Features.Invisible.enabled = false
        getgenv().InvisibleBlock = false
        updateGameSettings()
    end)

    -- 3) Desconectar connections
    pcall(function() if killAuraConn then killAuraConn:Disconnect(); killAuraConn = nil end end)
    pcall(function() if tpwalkConn then tpwalkConn:Disconnect(); tpwalkConn = nil end end)
    pcall(function() if xrayConnection then xrayConnection:Disconnect(); xrayConnection = nil end end)
    pcall(function() if KillAuraRing.conn then KillAuraRing.conn:Disconnect(); KillAuraRing.conn = nil end end)
    pcall(function() if Bypass.antiAFKConn then Bypass.antiAFKConn:Disconnect(); Bypass.antiAFKConn = nil end end)

    -- 4) Restaurar X-Ray (transparência 0)
    pcall(function()
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then v.LocalTransparencyModifier = 0 end
        end
    end)

    -- 5) Remover parts visuais criados pelo script
    pcall(function()
        local ring = workspace:FindFirstChild("KillAuraRing_xPHub")
        if ring then ring:Destroy() end
    end)
    pcall(function()
        local hb = workspace:FindFirstChild("HitboxVisualizer_xPHub")
        if hb then hb:Destroy() end
    end)
    pcall(function()
        local sp = workspace:FindFirstChild("SpawnPlacePlatform")
        if sp then sp:Destroy() end
    end)
    pcall(function() destroyCirclePart() end)

    -- 6) Restaurar Hitbox original (desfaz o hook)
    pcall(function()
        if OriginalBox then
            local Core = getCore()
            if Core then
                local combatHit = Core.Get and Core.Get("Combat", "Hit")
                if combatHit then combatHit.Box = OriginalBox end
            end
        end
        HitboxState.installed = false
        HitboxState.active = false
    end)

    -- 7) Restaurar hook do Kick (metatable) se aplicável
    pcall(function()
        if Bypass.hookInstalled and Bypass.originalNamecall then
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            mt.__namecall = Bypass.originalNamecall
            setreadonly(mt, true)
            Bypass.hookInstalled = false
            Bypass.originalNamecall = nil
        end
    end)

    -- 8) Restaurar Invisible remote hook
    pcall(function()
        Invisible.hooked = false
        Invisible.remote = nil
    end)

    -- 9) Destruir a UI
    pcall(function()
        if Window and Window.ScreenGui then
            Window.ScreenGui:Destroy()
        end
    end)

    -- 10) Log final
    pcall(function() print("[xP Hub] Script descarregado com sucesso.") end)
end

