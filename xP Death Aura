            and ReplicatedStorage.Remotes:FindFirstChild("Replication")
            and ReplicatedStorage.Remotes.Replication:FindFirstChild("FullCustomReplicationUnreliable")
        if not Remote then notify("Invisible", "Remote não encontrado!"); Features.Invisible.enabled = false; return end
        hookReplicationRemote(Remote)
