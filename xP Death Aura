            Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(1, -32, 0.5, -9),
            BackgroundColor3 = defaultState and Theme.Accent or Theme.ToggleOff,
            Text = defaultState and "✓" or "", TextColor3 = Theme.Text,
            Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false,
