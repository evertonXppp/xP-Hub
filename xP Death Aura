-- BYPASS SEGURO (ativo por padrão - sem UI)
local Bypass = {
    AntiKick = true,
    AntiAC = true,
    hookInstalled = false,
    originalNamecall = nil,
    antiAFKConn = nil,
}

local function safeCall(fn, ...)
    local ok, result = pcall(fn, ...)
    if ok then return result end
    return nil
end

local function installKickHook()
    if Bypass.hookInstalled then return true end
    if not game:IsLoaded() then return false end

    local ok = safeCall(function()
        local mt = getrawmetatable(game)
        if not mt then return false end
        local oldNC = mt.__namecall
        if Bypass.originalNamecall == nil then
            Bypass.originalNamecall = oldNC
        end
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method
            pcall(function() method = getnamecallmethod() end)
            if method == "Kick" and (Bypass.AntiKick or Bypass.AntiAC) then
                local isSelf = false
                pcall(function() isSelf = (self == LP) end)
                if isSelf then return nil end
            end
            return Bypass.originalNamecall(self, ...)
        end)
        setreadonly(mt, true)
        return true
    end)

    if ok == true then
        Bypass.hookInstalled = true
        return true
    end
    return false
end

local function installAntiAFK()
    if Bypass.antiAFKConn then return end
    safeCall(function()
        Bypass.antiAFKConn = LP.Idled:Connect(function()
            safeCall(function()
                local vu = game:GetService("VirtualUser")
                vu:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                task.wait(1)
                vu:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            end)
        end)
    end)
end

local function installAntiAC()
    if not Bypass.AntiAC then return end
    safeCall(function() LP.Kick = function() end end)
    installAntiAFK()
    installKickHook()
end

-- GAME SETTINGS
local function saveOriginal(valueObj)
    if valueObj and originalCooldowns[valueObj] == nil then
        originalCooldowns[valueObj] = valueObj.Value
    end
end

local function setValue(parent, name, value, saveOrig)
    if not parent then return end
    local v = parent:FindFirstChild(name)
    if not v then return end
    if saveOrig then saveOriginal(v) end
    v.Value = value
end

local function updateGameSettings()
    local settings = ReplicatedStorage:FindFirstChild("Settings")
    if not settings then return end
    local cooldowns = settings:FindFirstChild("Cooldowns")
    local multipliers = settings:FindFirstChild("Multipliers")
    local toggles = settings:FindFirstChild("Toggles")

    if Features.NoCooldown.enabled then
        if cooldowns then
            for _, cd in pairs(cooldowns:GetChildren()) do
                if cd:IsA("NumberValue") then saveOriginal(cd); cd.Value = 0 end
            end
        end
    else
        if cooldowns then
            for _, cd in pairs(cooldowns:GetChildren()) do
                if cd:IsA("NumberValue") and originalCooldowns[cd] ~= nil then
                    cd.Value = originalCooldowns[cd]
                end
            end
        end
    end

    if multipliers then
        setValue(multipliers, "MeleeSpeed", Features.MeleeSpeed, true)
        setValue(multipliers, "DashSpeed", Features.DashSpeed, true)
        if Features.InfiniteUltimate.enabled then
            setValue(multipliers, "UltimateTimer", 1e9, true)
            setValue(multipliers, "UltimateDamage", 1e9, true)
        else
            local ut = multipliers:FindFirstChild("UltimateTimer")
            local ud = multipliers:FindFirstChild("UltimateDamage")
            if ut and originalCooldowns[ut] ~= nil then ut.Value = originalCooldowns[ut] end
            if ud and originalCooldowns[ud] ~= nil then ud.Value = originalCooldowns[ud] end
        end
    end

    if toggles then
        setValue(toggles, "DisableHitStun", Features.NoStun.enabled, false)
        setValue(toggles, "NoStunOnMiss", Features.NoStun.enabled, false)
        setValue(toggles, "InstantTransformation", Features.InfiniteUltimate.enabled, false)
        setValue(toggles, "NoSlowdowns", Features.NoSlowdowns.enabled, false)
        setValue(toggles, "NoJumpFatigue", Features.NoJumpFatigue.enabled, false)
        setValue(toggles, "MultiUseCutscenes", Features.MultiUseCutscenes.enabled, false)
        setValue(toggles, "Endless", Features.Endless.enabled, false)
        setValue(toggles, "DisableCombatTimer", Features.DisableCombatTimer.enabled, false)
    end
end

