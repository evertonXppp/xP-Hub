local function Create(instance, properties, children)
    local obj = Instance.new(instance)
    for k, v in pairs(properties) do obj[k] = v end
    if children then
        for _, child in ipairs(children) do child.Parent = obj end
    end
    return obj
end

local function Tween(obj, time, properties)
    TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties):Play()
end

