-- ========================================================
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if ConsumedInputs[input] then
        ConsumedInputs[input] = nil
        return
    end

    for _, kb in pairs(ToggleKeybinds) do
        if kb.GetKey() and input.KeyCode == kb.GetKey() then
            local newState = not kb.State()
            kb.SetState(newState)
            Tween(kb.ToggleBtn, 0.2, {BackgroundColor3 = newState and Theme.ToggleOn or Theme.ToggleOff})
            Tween(kb.Circle, 0.2, {Position = newState and UDim2.new(1, -16, 0, 2) or UDim2.new(0, 2, 0, 2)})
            if not kb.NoNotify then NotifyToggle(kb.Text, newState) end
            if kb.Callback then kb.Callback(newState) end
        end
    end
end)

