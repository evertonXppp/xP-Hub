function Library:SelectTab(tabName)
    for _, tab in pairs(self.Tabs) do
        if tab.Name == tabName then
            for _, otherTab in pairs(self.Tabs) do
                otherTab.Button.BackgroundColor3 = Theme.TabsBG
                otherTab.Button.Font = Enum.Font.GothamSemibold
                otherTab.Page.Visible = false
            end
            tab.Button.BackgroundColor3 = Theme.Accent
            tab.Button.Font = Enum.Font.GothamBold
            tab.Page.Visible = true
            self.ActiveTab = tab
            return true
        end
    end
    return false
end

function Library:UpdateTheme(newColor)
    Theme.Accent = newColor
    Theme.ToggleOn = newColor
    Theme.SliderFill = newColor

    for _, tabBtn in pairs(CreatedElements.TabButtons) do
        if tabBtn.BackgroundColor3 ~= Theme.Sidebar and tabBtn.BackgroundColor3 ~= Theme.TabsBG then
            tabBtn.BackgroundColor3 = newColor
        end
    end
    for _, toggleData in pairs(CreatedElements.Toggles) do
        if toggleData.State then
            toggleData.Btn.BackgroundColor3 = newColor
        end
    end
    for _, sliderData in pairs(CreatedElements.Sliders) do
        sliderData.Fill.BackgroundColor3 = newColor
        sliderData.ValueLabel.TextColor3 = newColor
    end
    for _, checkData in pairs(CreatedElements.Checkboxes) do
        if checkData.State then
            checkData.Box.BackgroundColor3 = newColor
        end
    end
    for _, keybindData in pairs(CreatedElements.Keybinds) do
        keybindData.Btn.TextColor3 = newColor
    end
    for _, accentBar in pairs(CreatedElements.NotifAccentBars) do
        if accentBar and accentBar.Parent then
            accentBar.BackgroundColor3 = newColor
        end
    end
end

